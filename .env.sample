# ==========================================
# SYNAPSEHQ ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# Neon Postgres connection string.
# Use the pooled connection string for serverless runtime queries.
# Get this from your Neon project dashboard under "Connection Details".
DATABASE_URL="postgresql://[user]:[password]@[neon-host-endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# Optional direct (unpooled) connection string for Drizzle Kit migrations.
# Falls back to DATABASE_URL when omitted.
DATABASE_URL_UNPOOLED=""

# Public application URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Custom auth secret used for JWT signing and rate-limit identifier hashing.
# Generate a strong random value with: openssl rand -base64 32
# This value must never be exposed to the client.
JWT_SECRET=""

# Absolute authentication session lifetime in seconds (default: 7 days).
AUTH_SESSION_TTL_SECONDS="604800"

# Optional isolated database for integration tests.
# Use a separate Neon branch or database, never the development database.
TEST_DATABASE_URL=""

# Local Docker Compose PostgreSQL credentials.
# Used only by docker-compose.yml. Never use production credentials here.
POSTGRES_DB="synapsehq"
POSTGRES_USER="synapsehq"
POSTGRES_PASSWORD=""
