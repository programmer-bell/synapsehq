# ==========================================
# SYNAPSEHQ ENVIRONMENT VARIABLES TEMPLATE
# ==========================================

# Neon Postgres Connection String 
# (Get this from your Neon project dashboard under "Connection Details").
# Note: Use the pooled connection string (-pooler in the host) if available for serverless optimization.
DATABASE_URL="postgresql://[user]:[password]@[neon-host-endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# Application Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Custom Auth Secret (Generate a strong random 32+ character string for JWT signing)
JWT_SECRET="super-secret-jwt-key-change-this-in-production"